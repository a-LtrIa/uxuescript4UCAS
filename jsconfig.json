{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@injected/*": ["./injected/*"]
    }
  },
  "include": [
    "injected/**/*.js",
    "tests/**/*.js",
    "tests/**/*.mjs",
    "scripts/**/*.mjs",
    "eslint.config.js"
  ],
  "exclude": ["node_modules", "dist"]
}
