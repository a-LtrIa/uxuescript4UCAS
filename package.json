{
  "name": "uxuescript4ucas",
  "private": true,
  "version": "2.5.4",
  "type": "module",
  "scripts": {
    "lint": "eslint injected tests scripts eslint.config.js",
    "format": "prettier --write injected tests scripts jsconfig.json eslint.config.js package.json .github",
    "format:check": "prettier --check injected tests scripts jsconfig.json eslint.config.js package.json .github",
    "typecheck": "node scripts/typecheck.cjs",
    "build": "node scripts/build-scripts.mjs",
    "build:scripts": "node scripts/build-scripts.mjs",
    "dev": "node scripts/build-scripts.mjs --watch",
    "test": "node scripts/build-scripts.mjs && vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@~7.0.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "3.9.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
